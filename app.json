{
  "expo": {
    "name": "Zentra",
    "slug": "zentra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/icon.png",
    "scheme": "zentra",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abhiffhdsdsorganization.zentra",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/Logo/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you attach them to documents.",
          "cameraPermission": "The app accesses your camera to let you scan documents."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "211be624-9310-4100-aabc-85dec5f820e9"
      }
    },
    "owner": "abhiffhdsds-organization"
  }
}
